{
  "name": "gsc-tracker",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gsc/api --filter @gsc/mobile dev",
    "lint": "eslint . && pnpm --filter @gsc/mobile lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres s3 s3-init",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @gsc/api db:migrate",
    "db:seed": "pnpm --filter @gsc/api db:seed",
    "db:generate": "pnpm --filter @gsc/api db:generate",
    "fit:dump": "pnpm --filter @gsc/fit-parser fit:dump",
    "fit:sets": "pnpm --filter @gsc/fit-parser fit:sets"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
