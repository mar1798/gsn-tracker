# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://gsc:gsc@localhost:5433/gsc
POSTGRES_USER=gsc
POSTGRES_PASSWORD=gsc
POSTGRES_DB=gsc
POSTGRES_PORT=5433

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gsc-fit-files
S3_ACCESS_KEY=gsc-s3
S3_SECRET_KEY=gsc-s3-secret

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:3000
