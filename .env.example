# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://gsc:gsc@localhost:5433/gsc
POSTGRES_USER=gsc
POSTGRES_PASSWORD=gsc
POSTGRES_DB=gsc
POSTGRES_PORT=5433

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gsc-fit-files
S3_ACCESS_KEY=gsc-s3
S3_SECRET_KEY=gsc-s3-secret

# Auth. Generate a real secret for any shared environment: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Sign in with Apple: the app's bundle id (identity token audience). Unset = /auth/apple answers 501.
# APPLE_BUNDLE_ID=com.gsctracker.app

FIT_MAX_BYTES=20971520

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:3000
